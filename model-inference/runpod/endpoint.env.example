# Runpod Serverless endpoint environment for the official vLLM worker
# (runpod-workers/worker-vllm). Non-secret template: enter these in the endpoint's
# "Environment Variables" when creating it (see ../README.md). Never commit real values
# for HF_TOKEN or any key.

# Hugging Face model id. Non-thinking Qwen3 instruct, Apache-2.0, ~8 GB BF16.
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

# Stable id for clients: agent_runtime MODEL_NAME must equal this. Lets the model change
# without touching AWS configuration.
OPENAI_SERVED_MODEL_NAME_OVERRIDE=tatarbot-chat

# Context window (prompt + reply): 20 history messages at Discord's caps + 1024 output
# tokens. If VRAM forces it lower, lower MAX_HISTORY_MESSAGES in the runtime too.
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90

# Low-volume bot: few concurrent sequences, smaller KV-cache reservation.
MAX_NUM_SEQS=8

# Tool calling for the runtime's web_search tool (hermes parser for Qwen3). Without these
# the runtime's requests with `tools` are rejected (400 -> 502) while search is enabled.
ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER=hermes

# BF16/FP16 for ~4B. For ~8B on a 24 GB GPU use an AWQ/FP8 checkpoint and set e.g.
# QUANTIZATION=awq (only quantizations the chosen GPU and vLLM version support).
DTYPE=auto
# QUANTIZATION=

# Only for gated models; set as a Runpod secret, not here.
# HF_TOKEN={{ RUNPOD_SECRET_hf_token }}
