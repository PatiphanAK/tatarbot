# Local vLLM server (model-inference/local/compose.yaml). Copy with `make env`.

# Required. Clients send `Authorization: Bearer <key>`; put the same value in
# agent_runtime/.env as MODEL_API_KEY.
VLLM_API_KEY=

# Hugging Face model id and the stable name clients use (agent_runtime MODEL_NAME).
# Qwen3-1.7B (hybrid thinking, ~3.4 GB BF16) fits a 6 GB GPU and exercises the runtime's
# enable_thinking=false path. With >= 16 GB use the production model:
# MODEL=Qwen/Qwen3-4B-Instruct-2507
MODEL=Qwen/Qwen3-1.7B
SERVED_MODEL_NAME=tatarbot-chat

# Context window (prompt + reply). Production uses 16384; lower it here only for VRAM, and
# lower MAX_HISTORY_MESSAGES in the runtime with it.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=8
# Tool-call parser for the runtime's web_search tool (hermes for Qwen3).
# TOOL_CALL_PARSER=hermes

# Extra `vllm serve` flags, e.g. --enforce-eager (less VRAM, slower) or --quantization awq.
# VLLM_EXTRA_ARGS=--enforce-eager

# Only for gated models.
# HF_TOKEN=

# Published address. 127.0.0.1 serves a runtime started with `make up`. To reach it from
# the Compose runtime (MODEL_BASE_URL=http://host.docker.internal:8000/v1) bind the
# Docker bridge, e.g. 172.17.0.1, not 0.0.0.0.
# VLLM_BIND=127.0.0.1
# VLLM_PORT=8000
# VLLM_IMAGE_TAG=v0.11.0
