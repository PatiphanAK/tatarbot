# ---- Discord
# Also enable "Message Content Intent" under Bot -> Privileged Gateway Intents.
DISCORD_TOKEN=

# ---- Agent Runtime (TatarBot talks only to this; models/backends are configured there)
# POST {AGENT_BASE_URL}/v1/chat
AGENT_BASE_URL=http://localhost:8080
# Optional; sent as `Authorization: Bearer <key>`
AGENT_API_KEY=
# AGENT_TIMEOUT_SECS=120

# ---- Music (slash commands; independent of the Agent Runtime)
# Invite with the applications.commands scope and Connect + Speak permissions.
# MUSIC_STATIONS_FILE=/path/to/stations.toml   # default: built-in stations.toml
# MUSIC_MAX_QUEUE=50

# RUST_LOG=info,serenity=warn
