# ---- Discord
# Also enable "Message Content Intent" under Bot -> Privileged Gateway Intents.
DISCORD_TOKEN=

# ---- Agent Runtime (TatarBot talks only to this; models/backends are configured there)
# POST {AGENT_BASE_URL}/v1/chat
AGENT_BASE_URL=http://localhost:8080
# Optional; sent as `Authorization: Bearer <key>`
AGENT_API_KEY=
# AGENT_TIMEOUT_SECS=120

# ---- Music (slash commands; independent of the Agent Runtime)
# Invite with the applications.commands scope and Connect + Speak permissions.
# MUSIC_STATIONS_FILE=/path/to/stations.toml   # default: built-in stations.toml
# MUSIC_MAX_QUEUE=50

# ---- Server library (/upload, /library, /delete, /play <title>). Needs both of these.
# Local (make library-up):
# DATABASE_URL=postgres://tatarbot:tatarbot-local@127.0.0.1:55432/tatarbot
# MUSIC_S3_BUCKET=tatarbot-music
# MUSIC_S3_ENDPOINT=http://127.0.0.1:59000
# MUSIC_S3_CREATE_BUCKET=true
# AWS_ACCESS_KEY_ID=tatarbot-local
# AWS_SECRET_ACCESS_KEY=tatarbot-local-secret
# AWS_REGION=us-east-1
# Supabase (Supavisor session mode, verified TLS):
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-root-2021.crt
# MUSIC_UPLOAD_ROLE=DJ
# MUSIC_GUILD_QUOTA_MB=500

# RUST_LOG=info,serenity=warn
