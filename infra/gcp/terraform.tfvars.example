project_id     = "tatarbot-xxxxxx"
model_base_url = "https://ws-xxxxxxxx.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
model_name     = "qwen3.8-flash"

# Model provider: alibaba (above, key in secret <name>-model-api-key) or openai (key in
# its own secret <name>-openai-api-key). To switch to OpenAI: openai_enabled = true, apply,
# add the key as a version, deploy a runtime image that supports MODEL_ENABLE_THINKING=omit,
# then model_provider = "openai" and apply (docs/operations/runbook.md).
# model_provider    = "alibaba"
# openai_enabled    = false
# openai_model_name = "gpt-4.1-mini"

region = "asia-southeast1"
zone   = "asia-southeast1-b"

runtime_extra_environment = {
  SEARCH_MAX_SEARCHES    = "3"
  SEARCH_MAX_RESULTS     = "5"
  SEARCH_TIMEOUT_SECONDS = "10"
}

music_library_enabled = true

# Billing account for the budget alert (gcloud billing accounts list). Empty skips it.
billing_account = ""
budget_amount   = 20

# Optional daily VM schedule (default: 24/7). Google may begin a start or stop up to 15
# minutes late: schedule the start 15 minutes early.
# vm_schedule = {
#   start     = "45 17 * * *"
#   stop      = "0 0 * * *"
#   time_zone = "Asia/Bangkok"
# }
# Run 24/7 for a while but keep the schedule (and its role) for later: detaches it from the VM.
# vm_schedule_paused = true
