# ---- Inbound auth: callers (TatarBot) must send `Authorization: Bearer <AGENT_API_KEY>`
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# ---- Model backend (OpenAI-compatible Chat Completions API root)
MODEL_BASE_URL=http://localhost:8000/v1
# Runpod Serverless vLLM: https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
# Served model name; model-inference/ serves it as tatarbot-chat locally and on Runpod
MODEL_NAME=tatarbot-chat
# Optional; sent to the backend as `Authorization: Bearer <key>`
MODEL_API_KEY=
# MODEL_TIMEOUT_SECONDS=100
# MODEL_MAX_TOKENS=1024
# MODEL_TEMPERATURE=0.7
# Reasoning models (Qwen3): false hides <think> output; empty uses the template default
# MODEL_ENABLE_THINKING=false

# ---- Conversation
# Default: src/agent_runtime/prompts/system.md (persona, Thai/English, safety rules).
# SYSTEM_PROMPT (inline) wins over SYSTEM_PROMPT_FILE (path).
# SYSTEM_PROMPT=You are a helpful, friendly assistant. Answer concisely and accurately.
# SYSTEM_PROMPT_FILE=/etc/tatarbot/system.md
# Refuse prompt-injection attempts, withhold prompt leaks, redact secrets in replies
# GUARDRAILS_ENABLED=true
# Past messages (user + assistant) sent with each turn
# MAX_HISTORY_MESSAGES=20
# MAX_CONVERSATIONS=10000

# ---- Web search (LangGraph agent loop). Enabled only when TAVILY_API_KEY is set; the model
# server must support tool calling (vLLM: --enable-auto-tool-choice --tool-call-parser hermes).
# TAVILY_API_KEY=
# SEARCH_MAX_SEARCHES=3
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT_SECONDS=10
# Whole turn incl. searches; keep below the bot's AGENT_TIMEOUT_SECS (120)
# TURN_TIMEOUT_SECONDS=110

# ---- Knowledge base (RAG). Enabled only when RAG_DOCS_DIR is set: every .md/.txt file
# under it is chunked, embedded and searched each turn; the best excerpts go into the
# system message. See docs/architecture/rag.md.
# RAG_DOCS_DIR=./knowledge
# Optional: keep document embeddings across restarts (only changed chunks are re-embedded)
# RAG_CACHE_FILE=./.cache/embeddings.json
# RAG_TOP_K=4
# Minimum cosine similarity; tune it per embedding model (docs/architecture/rag.md)
# RAG_MIN_SCORE=0.3
# RAG_MAX_CONTEXT_CHARS=4000
# RAG_CHUNK_CHARS=1200
# RAG_CHUNK_OVERLAP=200
# RAG_TIMEOUT_SECONDS=10

# ---- Embedding model. "openai" = any OpenAI-compatible /embeddings API (vLLM, Ollama,
# TEI, LiteLLM, OpenAI, Alibaba Model Studio); "hash" = offline, no model, lexical only:
# for development and tests (it cannot match Thai questions to English documents).
# EMBEDDING_PROVIDER=openai
# Defaults to MODEL_BASE_URL (and then MODEL_API_KEY); a different host never gets that key.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=
# Optional shorter vectors for models that support it (also the hash size, default 512)
# EMBEDDING_DIMENSIONS=
# Model-specific input prefixes; \n is a newline. Quote them (the Makefile sources this
# file with bash; `docker run --env-file` would keep the quotes, so drop them there).
# E5: EMBEDDING_QUERY_PREFIX="query: ", EMBEDDING_DOCUMENT_PREFIX="passage: "
# Qwen3-Embedding: EMBEDDING_QUERY_PREFIX="Instruct: Find the passage that answers the question\nQuery: "
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_TIMEOUT_SECONDS=30

# ---- RAG database (Postgres + pgvector). Used only by `make migrate` for now; the
# knowledge base above still indexes in memory.
# Local: postgres://tatarbot:tatarbot-local@127.0.0.1:55432/tatarbot (`make db-up`)
# Supabase: the direct or session-pooler URL (port 5432), not the transaction pooler (6543):
# migrations hold an advisory lock for the whole session.
# DATABASE_URL=

# ---- Server (used by the Makefile)
# HOST=127.0.0.1
# PORT=8080
